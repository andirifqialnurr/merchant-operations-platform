generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  OWNER
  ADMIN
  SUPPORT
}

enum WorkspaceType {
  BUSINESS
  PERSONAL
}

/// Preset for labels, navigation, and onboarding (PRD v2 section 6.4).
enum BusinessTemplate {
  CAFE
  RESTAURANT
  BAKERY_RETAIL
  CLOUD_KITCHEN
  HC_ONLY
  BUSINESS_FINANCE_ONLY
  PERSONAL
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ModuleKind {
  CORE
  COMMERCIAL
}

enum PackageVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ModuleTier {
  BASIC
  PRO
  ADVANCED
}

enum ModuleInstallationStatus {
  NOT_INSTALLED
  PROVISIONING
  SETUP_REQUIRED
  ACTIVE
  ERROR
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeviceMode {
  POS
  KDS
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum UsageEnforcement {
  HARD_COUNT
  SOFT_METERED
  THROTTLED
}

enum IntegrationBindingStatus {
  DRAFT
  SETUP_REQUIRED
  ACTIVE
  PAUSED
  ERROR
  DISABLED
}

enum IntegrationBindingHealth {
  HEALTHY
  STALE
  BLOCKED
}

enum InboxEventStatus {
  PROCESSED
  RETRYING
  BLOCKED
  FAILED
}

enum EntitlementOverrideTarget {
  MODULE
  CAPABILITY
  LIMIT
}

enum EntitlementOverrideOperation {
  GRANT
  REVOKE
  ADD
  REPLACE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  TERMINATED
  /// Prepared but not started; gives no access.
  DRAFT
  /// Canceled, still usable until the period ends.
  CANCELED_AT_PERIOD_END
}

enum CatalogRecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductAvailability {
  AVAILABLE
  SOLD_OUT
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementDirection {
  IN
  OUT
}

enum OrderSource {
  POS
  SELF_ORDER
  MANUAL
  EXTERNAL
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  MERCHANT_QRIS
  TRANSFER
  EDC
  OTHER
}

enum PaymentStatus {
  UNPAID
  VERIFYING
  PAID
  REFUND_PENDING
  REFUNDED
  FAILED
  EXPIRED
}

enum SaleStatus {
  OPEN
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum RefundStatus {
  COMPLETED
}

model User {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                  String               @unique @db.VarChar(254)
  passwordHash           String               @map("password_hash") @db.VarChar(255)
  displayName            String               @map("display_name") @db.VarChar(160)
  status                 UserStatus           @default(ACTIVE)
  passwordChangedAt      DateTime             @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt            DateTime?            @map("last_login_at") @db.Timestamptz(6)
  /// Chosen language; null follows the browser.
  locale                 String?              @db.VarChar(2)
  /// Chosen theme; null follows the system.
  theme                  String?              @db.VarChar(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  loginSessions          LoginSession[]
  tenantMemberships      TenantMembership[]
  openedRegisterSessions PosRegisterSession[] @relation("RegisterSessionOpenedBy")
  closedRegisterSessions PosRegisterSession[] @relation("RegisterSessionClosedBy")
  acceptedInvitations    CoreInvitation[]
  cashMovements          PosCashMovement[]
  orders                 Order[]              @relation("OrderActor")
  canceledOrders         Order[]              @relation("OrderCanceledBy")
  paymentsRecorded       BillingPayment[]     @relation("PaymentActor")
  paymentsConfirmed      BillingPayment[]     @relation("PaymentConfirmedBy")
  refundsRecorded        SaleRefund[]         @relation("RefundActor")
  refundsApproved        SaleRefund[]         @relation("RefundApprovedBy")
  heldCarts              PosHeldCart[]

  @@map("users")
}

model PlatformUser {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String                 @unique @db.VarChar(254)
  passwordHash      String                 @map("password_hash") @db.VarChar(255)
  displayName       String                 @map("display_name") @db.VarChar(160)
  role              PlatformRole
  status            UserStatus             @default(ACTIVE)
  passwordChangedAt DateTime               @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  loginSessions     PlatformLoginSession[]

  @@index([role, status])
  @@map("platform_users")
}

model PlatformLoginSession {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddress  String?      @map("ip_address") @db.VarChar(45)
  userAgent  String?      @map("user_agent") @db.VarChar(512)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("platform_login_sessions")
}

model LoginSession {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(512)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// BACKOFFICE, or the mode of the device the session is bound to.
  surface    String      @default("BACKOFFICE") @db.VarChar(20)
  /// Set for POS and KDS sessions: they only work on this device.
  deviceId   String?     @map("device_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     CoreDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@index([deviceId])
  @@map("login_sessions")
}

model Tenant {
  id                           String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                         String                        @db.VarChar(160)
  slug                         String                        @unique @db.VarChar(80)
  status                       OrganizationUnitStatus        @default(ACTIVE)
  type                         WorkspaceType                 @default(BUSINESS)
  template                     BusinessTemplate              @default(CAFE)
  /// Default currency for new prices; ISO 4217.
  currency                     String                        @default("IDR") @db.Char(3)
  /// Default time zone for new locations; IANA name.
  timezone                     String                        @default("Asia/Jakarta") @db.VarChar(64)
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  brands                       Brand[]
  outlets                      Outlet[]
  auditLogs                    AuditLog[]
  idempotencyKeys              IdempotencyKey[]
  outboxEvents                 OutboxEvent[]
  memberships                  TenantMembership[]
  roles                        Role[]
  subscriptions                Subscription[]
  subscriptionAddons           CoreSubscriptionAddon[]
  entitlementOverrides         CoreEntitlementOverride[]
  effectiveEntitlements        CoreEffectiveEntitlement[]
  moduleInstallations          CoreModuleInstallation[]
  moduleConfigs                CoreModuleConfig[]
  inboxEvents                  CoreInboxEvent[]
  integrationBindings          CoreIntegrationBinding[]
  usageEvents                  CoreUsageEvent[]
  usageCounters                CoreUsageCounter[]
  usageAdjustments             CoreUsageAdjustment[]
  limitNotifications           CoreLimitNotification[]
  devices                      CoreDevice[]
  invitations                  CoreInvitation[]
  catalogCategories            CatalogCategory[]
  catalogProducts              CatalogProduct[]
  catalogProductVariants       CatalogProductVariant[]
  catalogModifierGroups        CatalogModifierGroup[]
  catalogModifierOptions       CatalogModifierOption[]
  catalogProductModifierGroups CatalogProductModifierGroup[]
  catalogProductImages         CatalogProductImage[]
  catalogOutletProducts        CatalogOutletProduct[]
  posRegisterSessions          PosRegisterSession[]
  posCashMovements             PosCashMovement[]
  orders                       Order[]
  bills                        Bill[]
  payments                     BillingPayment[]
  sales                        Sale[]
  saleRefunds                  SaleRefund[]
  heldCarts                    PosHeldCart[]

  @@map("tenants")
}

model Brand {
  id        String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  name      String                 @db.VarChar(160)
  slug      String                 @db.VarChar(80)
  status    OrganizationUnitStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlets   Outlet[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("brands")
}

model Outlet {
  id                 String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  brandId            String                 @map("brand_id") @db.Uuid
  code               String                 @db.VarChar(40)
  name               String                 @db.VarChar(160)
  timezone           String                 @default("Asia/Jakarta") @db.VarChar(64)
  address            String?                @db.VarChar(500)
  status             OrganizationUnitStatus @default(ACTIVE)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  brand              Brand                  @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  auditLogs          AuditLog[]
  idempotencyKeys    IdempotencyKey[]
  outboxEvents       OutboxEvent[]
  assignments        OutletAssignment[]
  catalogProducts    CatalogOutletProduct[]
  registerSessions   PosRegisterSession[]
  devices            CoreDevice[]
  cashMovements      PosCashMovement[]
  orders             Order[]
  bills              Bill[]
  payments           BillingPayment[]
  sales              Sale[]
  saleRefunds        SaleRefund[]
  heldCarts          PosHeldCart[]
  saleNumberCounter  SaleNumberCounter?
  orderNumberCounter OrderNumberCounter?

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, brandId])
  @@index([tenantId, createdAt])
  @@map("outlets")
}

model CatalogCategory {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  name         String              @db.VarChar(160)
  slug         String              @db.VarChar(80)
  displayOrder Int                 @default(0) @map("display_order")
  status       CatalogRecordStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products     CatalogProduct[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, status, displayOrder])
  @@map("categories")
}

model CatalogProduct {
  id             String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                        @map("tenant_id") @db.Uuid
  categoryId     String                        @map("category_id") @db.Uuid
  name           String                        @db.VarChar(160)
  slug           String                        @db.VarChar(80)
  description    String?                       @db.VarChar(2000)
  basePriceMinor BigInt                        @map("base_price_minor") @db.BigInt
  currency       String                        @default("IDR") @db.Char(3)
  availability   ProductAvailability           @default(AVAILABLE)
  status         CatalogRecordStatus           @default(ACTIVE)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       CatalogCategory               @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  variants       CatalogProductVariant[]
  modifierGroups CatalogProductModifierGroup[]
  images         CatalogProductImage[]
  outletProducts CatalogOutletProduct[]
  orderItems     OrderItem[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, availability, status])
  @@map("products")
}

model CatalogProductVariant {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  name            String              @db.VarChar(160)
  priceDeltaMinor BigInt              @default(0) @map("price_delta_minor") @db.BigInt
  availability    ProductAvailability @default(AVAILABLE)
  displayOrder    Int                 @default(0) @map("display_order")
  status          CatalogRecordStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product         CatalogProduct      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, name])
  @@index([tenantId, productId, status, displayOrder])
  @@map("product_variants")
}

model CatalogModifierGroup {
  id            String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                        @map("tenant_id") @db.Uuid
  name          String                        @db.VarChar(160)
  selectionType ModifierSelectionType         @default(SINGLE) @map("selection_type")
  minSelections Int                           @default(0) @map("min_selections")
  maxSelections Int                           @default(1) @map("max_selections")
  displayOrder  Int                           @default(0) @map("display_order")
  status        CatalogRecordStatus           @default(ACTIVE)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  options       CatalogModifierOption[]
  productLinks  CatalogProductModifierGroup[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status, displayOrder])
  @@map("modifier_groups")
}

model CatalogModifierOption {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  groupId         String               @map("group_id") @db.Uuid
  name            String               @db.VarChar(160)
  priceDeltaMinor BigInt               @default(0) @map("price_delta_minor") @db.BigInt
  availability    ProductAvailability  @default(AVAILABLE)
  displayOrder    Int                  @default(0) @map("display_order")
  status          CatalogRecordStatus  @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group           CatalogModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, groupId, name])
  @@index([tenantId, groupId, status, displayOrder])
  @@map("modifier_options")
}

model CatalogProductModifierGroup {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  modifierGroupId String               @map("modifier_group_id") @db.Uuid
  displayOrder    Int                  @default(0) @map("display_order")
  status          CatalogRecordStatus  @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product         CatalogProduct       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  modifierGroup   CatalogModifierGroup @relation(fields: [tenantId, modifierGroupId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, modifierGroupId])
  @@index([tenantId, productId, status, displayOrder])
  @@index([tenantId, modifierGroupId, status])
  @@map("product_modifier_groups")
}

model CatalogProductImage {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  objectKey    String              @map("object_key") @db.VarChar(512)
  contentType  String              @map("content_type") @db.VarChar(100)
  altText      String?             @map("alt_text") @db.VarChar(300)
  width        Int?
  height       Int?
  isPrimary    Boolean             @default(false) @map("is_primary")
  displayOrder Int                 @default(0) @map("display_order")
  status       CatalogRecordStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product      CatalogProduct      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, objectKey])
  @@index([tenantId, productId, status, displayOrder])
  @@map("product_images")
}

model CatalogOutletProduct {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  outletId             String               @map("outlet_id") @db.Uuid
  productId            String               @map("product_id") @db.Uuid
  priceOverrideMinor   BigInt?              @map("price_override_minor") @db.BigInt
  availabilityOverride ProductAvailability? @map("availability_override")
  displayOrder         Int                  @default(0) @map("display_order")
  status               CatalogRecordStatus  @default(ACTIVE)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet               Outlet               @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  product              CatalogProduct       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, productId])
  @@index([tenantId, outletId, status, displayOrder])
  @@index([tenantId, productId, status])
  @@map("outlet_products")
}

model TenantMembership {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  status      MembershipStatus   @default(ACTIVE)
  allOutlets  Boolean            @default(false) @map("all_outlets")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  assignments OutletAssignment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model Permission {
  key         String           @id @db.VarChar(120)
  description String           @db.VarChar(255)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model Role {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  code        String                 @db.VarChar(80)
  name        String                 @db.VarChar(160)
  isSystem    Boolean                @default(false) @map("is_system")
  status      OrganizationUnitStatus @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  userLinks   UserRole[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("roles")
}

model RolePermission {
  tenantId      String     @map("tenant_id") @db.Uuid
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key") @db.VarChar(120)
  role          Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  tenantId     String           @map("tenant_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model OutletAssignment {
  tenantId     String           @map("tenant_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  outletId     String           @map("outlet_id") @db.Uuid
  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  outlet       Outlet           @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, outletId])
  @@index([tenantId, outletId])
  @@map("outlet_assignments")
}

model ModuleDefinition {
  key                   String                     @id @db.VarChar(80)
  name                  String                     @db.VarChar(160)
  kind                  ModuleKind
  status                OrganizationUnitStatus     @default(ACTIVE)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  packageLinks          CorePackageModule[]
  effectiveEntitlements CoreEffectiveEntitlement[]
  installations         CoreModuleInstallation[]
  bindingsAsSource      CoreIntegrationBinding[]   @relation("BindingSource")
  bindingsAsTarget      CoreIntegrationBinding[]   @relation("BindingTarget")
  dependencies          ModuleDependency[]         @relation("ModuleDependencies")
  dependents            ModuleDependency[]         @relation("ModuleDependents")

  @@index([kind, status])
  @@map("modules")
}

model ModuleDependency {
  moduleKey     String           @map("module_key") @db.VarChar(80)
  dependencyKey String           @map("dependency_key") @db.VarChar(80)
  module        ModuleDefinition @relation("ModuleDependencies", fields: [moduleKey], references: [key], onDelete: Cascade)
  dependency    ModuleDefinition @relation("ModuleDependents", fields: [dependencyKey], references: [key], onDelete: Restrict)

  @@id([moduleKey, dependencyKey])
  @@index([dependencyKey])
  @@map("module_dependencies")
}

/// What is sold.
model CorePackage {
  id        String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key       String                 @unique @db.VarChar(80)
  name      String                 @db.VarChar(160)
  status    OrganizationUnitStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions  CorePackageVersion[]

  @@map("core_packages")
}

/// One fixed definition of a package. Database triggers refuse any change to a
/// version, or to its modules, capabilities, and limits, once it is published.
model CorePackageVersion {
  id            String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packageId     String                  @map("package_id") @db.Uuid
  version       Int
  status        PackageVersionStatus    @default(DRAFT)
  template      BusinessTemplate?
  publishedAt   DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  package       CorePackage             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  modules       CorePackageModule[]
  capabilities  CorePackageCapability[]
  limits        CorePackageLimit[]
  subscriptions Subscription[]

  @@unique([packageId, version])
  @@index([packageId, status])
  @@map("core_package_versions")
}

model CorePackageModule {
  packageVersionId String             @map("package_version_id") @db.Uuid
  moduleKey        String             @map("module_key") @db.VarChar(80)
  tier             ModuleTier         @default(BASIC)
  packageVersion   CorePackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  module           ModuleDefinition   @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([packageVersionId, moduleKey])
  @@index([moduleKey])
  @@map("core_package_modules")
}

/// A capability added to, or taken away from, what the module tier gives by default.
model CorePackageCapability {
  packageVersionId String             @map("package_version_id") @db.Uuid
  capabilityKey    String             @map("capability_key") @db.VarChar(160)
  included         Boolean
  packageVersion   CorePackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@id([packageVersionId, capabilityKey])
  @@map("core_package_capabilities")
}

/// `unlimited` is a flag; `value` is null exactly when it is set.
model CorePackageLimit {
  packageVersionId String             @map("package_version_id") @db.Uuid
  dimensionKey     String             @map("dimension_key") @db.VarChar(120)
  value            BigInt?            @db.BigInt
  unlimited        Boolean            @default(false)
  packageVersion   CorePackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@id([packageVersionId, dimensionKey])
  @@map("core_package_limits")
}

model Subscription {
  id               String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  /// The exact version that was bought; never a draft (database trigger).
  packageVersionId String                  @map("package_version_id") @db.Uuid
  cycleStartsAt    DateTime                @map("cycle_starts_at") @db.Timestamptz(6)
  cycleEndsAt      DateTime?               @map("cycle_ends_at") @db.Timestamptz(6)
  status           SubscriptionStatus
  startsAt         DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?               @map("ends_at") @db.Timestamptz(6)
  graceEndsAt      DateTime?               @map("grace_ends_at") @db.Timestamptz(6)
  supersededAt     DateTime?               @map("superseded_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  packageVersion   CorePackageVersion      @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  addons           CoreSubscriptionAddon[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([packageVersionId, status])
  @@map("subscriptions")
}

/// Something bought on top of the package for a period, e.g. extra locations.
model CoreSubscriptionAddon {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  addonKey       String       @map("addon_key") @db.VarChar(120)
  quantity       Int          @default(1)
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([subscriptionId, addonKey, startsAt])
  @@index([tenantId, subscriptionId])
  @@map("core_subscription_addons")
}

/// One decision that changes what a tenant gets compared with its package.
/// Rows are history: a newer decision closes the older one (sets `endsAt`).
model CoreEntitlementOverride {
  id         String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String                       @map("tenant_id") @db.Uuid
  targetType EntitlementOverrideTarget    @map("target_type")
  targetKey  String                       @map("target_key") @db.VarChar(160)
  operation  EntitlementOverrideOperation
  /// Only for LIMIT targets.
  value      BigInt?                      @db.BigInt
  reason     String                       @db.VarChar(500)
  startsAt   DateTime                     @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime?                    @map("ends_at") @db.Timestamptz(6)
  /// A merchant user or a platform user.
  actorId    String?                      @map("actor_id") @db.Uuid
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, targetType, targetKey, startsAt])
  @@map("core_entitlement_overrides")
}

/// Projection of what a tenant can use right now, one row per enabled module.
/// Rebuilt from the subscription, its package version, and the overrides.
model CoreEffectiveEntitlement {
  tenantId     String           @map("tenant_id") @db.Uuid
  moduleKey    String           @map("module_key") @db.VarChar(80)
  tier         ModuleTier
  capabilities Json             @default("[]")
  limits       Json             @default("[]")
  computedAt   DateTime         @map("computed_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module       ModuleDefinition @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([tenantId, moduleKey])
  @@index([moduleKey])
  @@map("core_effective_entitlements")
}

/// A commercial module set up for a tenant (architecture.md 6.1). The row stays
/// when the module is suspended or uninstalled, so its data and settings are reused.
model CoreModuleInstallation {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  moduleKey           String                   @map("module_key") @db.VarChar(80)
  status              ModuleInstallationStatus
  configSchemaVersion Int                      @default(1) @map("config_schema_version")
  provisionedAt       DateTime?                @map("provisioned_at") @db.Timestamptz(6)
  activatedAt         DateTime?                @map("activated_at") @db.Timestamptz(6)
  setupRequiredReason String?                  @map("setup_required_reason") @db.VarChar(500)
  errorMessage        String?                  @map("error_message") @db.VarChar(500)
  suspendedReason     String?                  @map("suspended_reason") @db.VarChar(500)
  /// A merchant user or a platform user.
  actorId             String?                  @map("actor_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module              ModuleDefinition         @relation(fields: [moduleKey], references: [key], onDelete: Restrict)
  configs             CoreModuleConfig[]

  @@unique([tenantId, moduleKey])
  @@unique([tenantId, id])
  @@index([moduleKey, status])
  @@map("core_module_installations")
}

/// The module's settings for a tenant, one row per settings schema version.
model CoreModuleConfig {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  installationId String                 @map("installation_id") @db.Uuid
  schemaVersion  Int                    @map("schema_version")
  config         Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  installation   CoreModuleInstallation @relation(fields: [tenantId, installationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([installationId, schemaVersion])
  @@index([tenantId, installationId])
  @@map("core_module_configs")
}

/// That one handler dealt with one event, so a repeated delivery has one effect.
model CoreInboxEvent {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  consumerName    String           @map("consumer_name") @db.VarChar(120)
  eventId         String           @map("event_id") @db.Uuid
  eventType       String           @map("event_type") @db.VarChar(160)
  status          InboxEventStatus
  resultReference String?          @map("result_reference") @db.VarChar(200)
  /// Safe to show: never the payload.
  lastError       String?          @map("last_error") @db.VarChar(500)
  attemptCount    Int              @default(1) @map("attempt_count")
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, consumerName, eventId])
  @@index([tenantId, status, updatedAt])
  @@index([eventId])
  @@map("core_inbox_events")
}

/// The switch between two modules for one workspace: when the source module
/// announces the event, the target module's handler reacts (architecture.md 6.2).
model CoreIntegrationBinding {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  sourceModuleKey     String                   @map("source_module_key") @db.VarChar(80)
  eventType           String                   @map("event_type") @db.VarChar(160)
  eventVersion        Int                      @default(1) @map("event_version")
  targetModuleKey     String                   @map("target_module_key") @db.VarChar(80)
  handlerKey          String                   @map("handler_key") @db.VarChar(120)
  status              IntegrationBindingStatus
  health              IntegrationBindingHealth @default(HEALTHY)
  configSchemaVersion Int                      @default(1) @map("config_schema_version")
  config              Json                     @default("{}")
  /// Events that occurred before this are not delivered.
  effectiveFrom       DateTime                 @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime?                @map("effective_to") @db.Timestamptz(6)
  lastError           String?                  @map("last_error") @db.VarChar(500)
  auditReason         String?                  @map("audit_reason") @db.VarChar(500)
  actorId             String?                  @map("actor_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceModule        ModuleDefinition         @relation("BindingSource", fields: [sourceModuleKey], references: [key], onDelete: Restrict)
  targetModule        ModuleDefinition         @relation("BindingTarget", fields: [targetModuleKey], references: [key], onDelete: Restrict)

  @@unique([tenantId, sourceModuleKey, eventType, targetModuleKey, handlerKey], map: "core_integration_bindings_route_key")
  @@index([tenantId, targetModuleKey])
  @@index([tenantId, status])
  @@map("core_integration_bindings")
}

/// What a package can limit. Platform data, the same for every tenant.
model CoreUsageDimension {
  key           String                  @id @db.VarChar(120)
  unit          String                  @db.VarChar(20)
  enforcement   UsageEnforcement
  events        CoreUsageEvent[]
  counters      CoreUsageCounter[]
  adjustments   CoreUsageAdjustment[]
  notifications CoreLimitNotification[]

  @@map("core_usage_dimensions")
}

/// One thing that was used. The same idempotency key never counts twice.
model CoreUsageEvent {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  dimensionKey    String             @map("dimension_key") @db.VarChar(120)
  quantity        BigInt             @db.BigInt
  sourceType      String             @map("source_type") @db.VarChar(120)
  sourceReference String?            @map("source_reference") @db.VarChar(160)
  idempotencyKey  String             @map("idempotency_key") @db.VarChar(255)
  occurredAt      DateTime           @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimension       CoreUsageDimension @relation(fields: [dimensionKey], references: [key], onDelete: Restrict)

  @@unique([tenantId, dimensionKey, idempotencyKey])
  @@index([tenantId, dimensionKey, occurredAt])
  @@map("core_usage_events")
}

/// A correction by a person, with a reason, for one period.
model CoreUsageAdjustment {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  dimensionKey String             @map("dimension_key") @db.VarChar(120)
  periodStart  DateTime           @map("period_start") @db.Timestamptz(6)
  delta        BigInt             @db.BigInt
  reason       String             @db.VarChar(500)
  actorId      String             @map("actor_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimension    CoreUsageDimension @relation(fields: [dimensionKey], references: [key], onDelete: Restrict)

  @@index([tenantId, dimensionKey, periodStart])
  @@map("core_usage_adjustments")
}

/// The running total of a period; it can be rebuilt from events and adjustments.
model CoreUsageCounter {
  tenantId     String             @map("tenant_id") @db.Uuid
  dimensionKey String             @map("dimension_key") @db.VarChar(120)
  periodStart  DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd    DateTime           @map("period_end") @db.Timestamptz(6)
  quantity     BigInt             @default(0) @db.BigInt
  calculatedAt DateTime           @default(now()) @map("calculated_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimension    CoreUsageDimension @relation(fields: [dimensionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, dimensionKey, periodStart])
  @@map("core_usage_counters")
}

/// A threshold is announced once per period.
model CoreLimitNotification {
  tenantId     String             @map("tenant_id") @db.Uuid
  dimensionKey String             @map("dimension_key") @db.VarChar(120)
  periodStart  DateTime           @map("period_start") @db.Timestamptz(6)
  threshold    Int
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimension    CoreUsageDimension @relation(fields: [dimensionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, dimensionKey, periodStart, threshold])
  @@map("core_limit_notifications")
}

/// A cashier tablet or kitchen screen registered for one outlet. It proves
/// itself with a credential of its own, separate from any person's session.
model CoreDevice {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  outletId            String         @map("outlet_id") @db.Uuid
  mode                DeviceMode
  label               String         @db.VarChar(80)
  status              DeviceStatus   @default(PENDING)
  /// SHA-256 of the one-time activation code; cleared when used.
  activationCodeHash  String?        @unique @map("activation_code_hash") @db.Char(64)
  activationExpiresAt DateTime?      @map("activation_expires_at") @db.Timestamptz(6)
  /// SHA-256 of the device's secret; the secret itself is never stored.
  credentialHash      String?        @unique @map("credential_hash") @db.Char(64)
  activatedAt         DateTime?      @map("activated_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  revokedAt           DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedBy           String?        @map("revoked_by") @db.Uuid
  createdBy           String?        @map("created_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet              Outlet         @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  loginSessions       LoginSession[]

  @@index([tenantId, outletId])
  @@index([tenantId, status])
  @@map("core_devices")
}

/// An invitation of an email address into a workspace, with what it grants.
/// Only the hash of the link's secret is stored.
model CoreInvitation {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  email          String           @db.VarChar(254)
  roleIds        String[]         @map("role_ids") @db.Uuid
  allOutlets     Boolean          @default(false) @map("all_outlets")
  outletIds      String[]         @default([]) @map("outlet_ids") @db.Uuid
  status         InvitationStatus @default(PENDING)
  tokenHash      String?          @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedBy      String?          @map("invited_by") @db.Uuid
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId String?          @map("accepted_user_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?          @map("revoked_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  acceptedUser   User?            @relation(fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("core_invitations")
}

model AuditLog {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  outletId      String?  @map("outlet_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(120)
  entityId      String?  @map("entity_id") @db.Uuid
  requestId     String?  @map("request_id") @db.VarChar(100)
  metadata      Json?
  channel       String?  @db.VarChar(20)
  reason        String?  @db.VarChar(500)
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet        Outlet?  @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, correlationId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  /// Null for workspace-level commands; those are kept unique by a partial index.
  outletId       String?           @map("outlet_id") @db.Uuid
  scope          String            @db.VarChar(120)
  key            String            @db.VarChar(255)
  requestHash    String?           @map("request_hash") @db.VarChar(128)
  status         IdempotencyStatus @default(PENDING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet         Outlet?           @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@unique([tenantId, outletId, scope, key])
  @@index([tenantId, outletId, expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  outletId      String?   @map("outlet_id") @db.Uuid
  type          String    @db.VarChar(160)
  aggregateType String    @map("aggregate_type") @db.VarChar(120)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  eventVersion  Int       @default(1) @map("event_version")
  correlationId String?   @map("correlation_id") @db.VarChar(100)
  causationId   String?   @map("causation_id") @db.Uuid
  actorType     String?   @map("actor_type") @db.VarChar(20)
  actorId       String?   @map("actor_id") @db.Uuid
  /// Module key of the code that produced the event.
  producer      String?   @db.VarChar(80)
  /// Where the command that announced the event came from.
  channel       String?   @db.VarChar(20)
  deviceId      String?   @map("device_id") @db.Uuid
  clientVersion String?   @map("client_version") @db.VarChar(80)
  recordedAt    DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  /// Set when the attempts ran out; the event is kept and not retried on its own.
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error") @db.Text
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet        Outlet?   @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, occurredAt])
  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

/// POS shift. One open session per cashier per outlet (partial unique index in SQL).
model PosRegisterSession {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  outletId          String                @map("outlet_id") @db.Uuid
  status            RegisterSessionStatus @default(OPEN)
  openedBy          String                @map("opened_by") @db.Uuid
  openedAt          DateTime              @default(now()) @map("opened_at") @db.Timestamptz(6)
  openingCashMinor  BigInt                @map("opening_cash_minor") @db.BigInt
  closedBy          String?               @map("closed_by") @db.Uuid
  closedAt          DateTime?             @map("closed_at") @db.Timestamptz(6)
  expectedCashMinor BigInt?               @map("expected_cash_minor") @db.BigInt
  countedCashMinor  BigInt?               @map("counted_cash_minor") @db.BigInt
  varianceMinor     BigInt?               @map("variance_minor") @db.BigInt
  varianceReason    String?               @map("variance_reason") @db.VarChar(500)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet                @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  opener            User                  @relation("RegisterSessionOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  closer            User?                 @relation("RegisterSessionClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  cashMovements     PosCashMovement[]
  payments          BillingPayment[]
  refunds           SaleRefund[]

  @@unique([tenantId, id])
  @@index([tenantId, outletId, status, openedAt])
  @@map("pos_register_sessions")
}

/// Cash put into or taken out of the drawer during a shift. Append-only.
model PosCashMovement {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  outletId          String                @map("outlet_id") @db.Uuid
  registerSessionId String                @map("register_session_id") @db.Uuid
  direction         CashMovementDirection
  amountMinor       BigInt                @map("amount_minor") @db.BigInt
  reason            String                @db.VarChar(300)
  actorId           String                @map("actor_id") @db.Uuid
  idempotencyKey    String                @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet                @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  registerSession   PosRegisterSession    @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: Restrict)
  actor             User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, registerSessionId, idempotencyKey])
  @@index([tenantId, registerSessionId, createdAt])
  @@map("pos_cash_movements")
}

/// Last order number handed out per outlet.
model OrderNumberCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  outletId   String @map("outlet_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")
  outlet     Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, outletId])
  @@map("order_number_counters")
}

/// An order taken at an outlet. Owned by the order-intake kernel.
model Order {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  outletId       String      @map("outlet_id") @db.Uuid
  orderNumber    Int         @map("order_number")
  source         OrderSource
  orderType      OrderType   @map("order_type")
  status         OrderStatus @default(DRAFT)
  currency       String      @db.Char(3)
  note           String?     @db.VarChar(500)
  submittedAt    DateTime?   @map("submitted_at") @db.Timestamptz(6)
  actorId        String?     @map("actor_id") @db.Uuid
  canceledAt     DateTime?   @map("canceled_at") @db.Timestamptz(6)
  canceledBy     String?     @map("canceled_by") @db.Uuid
  cancelReason   String?     @map("cancel_reason") @db.VarChar(300)
  idempotencyKey String      @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet         Outlet      @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  actor          User?       @relation("OrderActor", fields: [actorId], references: [id], onDelete: Restrict)
  canceler       User?       @relation("OrderCanceledBy", fields: [canceledBy], references: [id], onDelete: Restrict)
  items          OrderItem[]
  bill           Bill?

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, orderNumber])
  @@unique([tenantId, outletId, idempotencyKey])
  @@index([tenantId, outletId, status, createdAt])
  @@map("order_orders")
}

/// A snapshot line of an order; catalog changes never alter it.
model OrderItem {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  orderId             String              @map("order_id") @db.Uuid
  position            Int
  productId           String?             @map("product_id") @db.Uuid
  nameSnapshot        String              @map("name_snapshot") @db.VarChar(160)
  variantNameSnapshot String?             @map("variant_name_snapshot") @db.VarChar(160)
  unitPriceMinor      BigInt              @map("unit_price_minor") @db.BigInt
  quantity            Int
  lineTotalMinor      BigInt              @map("line_total_minor") @db.BigInt
  note                String?             @db.VarChar(300)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  product             CatalogProduct?     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  modifiers           OrderItemModifier[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderId, position])
  @@map("order_order_items")
}

model OrderItemModifier {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  orderItemId        String    @map("order_item_id") @db.Uuid
  position           Int
  groupNameSnapshot  String    @map("group_name_snapshot") @db.VarChar(160)
  optionNameSnapshot String    @map("option_name_snapshot") @db.VarChar(160)
  priceDeltaMinor    BigInt    @map("price_delta_minor") @db.BigInt
  orderItem          OrderItem @relation(fields: [tenantId, orderItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, orderItemId, position])
  @@map("order_item_modifiers")
}

/// What is owed for an order. Owned by the billing-payment-ledger kernel.
model Bill {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  outletId           String              @map("outlet_id") @db.Uuid
  orderId            String              @map("order_id") @db.Uuid
  currency           String              @db.Char(3)
  subtotalMinor      BigInt              @map("subtotal_minor") @db.BigInt
  discountMinor      BigInt              @default(0) @map("discount_minor") @db.BigInt
  taxMinor           BigInt              @default(0) @map("tax_minor") @db.BigInt
  serviceChargeMinor BigInt              @default(0) @map("service_charge_minor") @db.BigInt
  roundingMinor      BigInt              @default(0) @map("rounding_minor") @db.BigInt
  totalMinor         BigInt              @map("total_minor") @db.BigInt
  paidMinor          BigInt              @default(0) @map("paid_minor") @db.BigInt
  status             BillStatus          @default(UNPAID)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet             Outlet              @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  order              Order               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  allocations        PaymentAllocation[]
  sale               Sale?

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId, outletId, status, createdAt])
  @@map("billing_bills")
}

/// Money received. Append-only apart from status changes such as refunds.
model BillingPayment {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  outletId          String              @map("outlet_id") @db.Uuid
  registerSessionId String?             @map("register_session_id") @db.Uuid
  method            PaymentMethod
  amountMinor       BigInt              @map("amount_minor") @db.BigInt
  tenderedMinor     BigInt?             @map("tendered_minor") @db.BigInt
  status            PaymentStatus
  reference         String?             @db.VarChar(120)
  actorId           String              @map("actor_id") @db.Uuid
  confirmedBy       String?             @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  idempotencyKey    String              @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet              @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  registerSession   PosRegisterSession? @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: Restrict)
  actor             User                @relation("PaymentActor", fields: [actorId], references: [id], onDelete: Restrict)
  confirmer         User?               @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  allocations       PaymentAllocation[]
  refunds           SaleRefund[]

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, idempotencyKey])
  @@index([tenantId, registerSessionId, method, status])
  @@map("billing_payments")
}

model PaymentAllocation {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  paymentId   String         @map("payment_id") @db.Uuid
  billId      String         @map("bill_id") @db.Uuid
  amountMinor BigInt         @map("amount_minor") @db.BigInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  payment     BillingPayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  bill        Bill           @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, paymentId, billId])
  @@index([tenantId, billId])
  @@map("billing_payment_allocations")
}

/// Last sale number handed out per outlet.
model SaleNumberCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  outletId   String @map("outlet_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")
  outlet     Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, outletId])
  @@map("sales_number_counters")
}

/// A completed sale: the record finance and reports are built from.
model Sale {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  outletId    String       @map("outlet_id") @db.Uuid
  saleNumber  Int          @map("sale_number")
  billId      String       @map("bill_id") @db.Uuid
  status      SaleStatus
  totalMinor  BigInt       @map("total_minor") @db.BigInt
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet      Outlet       @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  bill        Bill         @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict)
  refunds     SaleRefund[]

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, saleNumber])
  @@unique([tenantId, billId])
  @@index([tenantId, outletId, completedAt])
  @@map("sales_sales")
}

/// A refund of a completed sale. The sale and its payment are never changed.
model SaleRefund {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  outletId          String             @map("outlet_id") @db.Uuid
  saleId            String             @map("sale_id") @db.Uuid
  paymentId         String             @map("payment_id") @db.Uuid
  registerSessionId String             @map("register_session_id") @db.Uuid
  method            PaymentMethod
  amountMinor       BigInt             @map("amount_minor") @db.BigInt
  reason            String             @db.VarChar(300)
  status            RefundStatus       @default(COMPLETED)
  actorId           String             @map("actor_id") @db.Uuid
  approvedBy        String?            @map("approved_by") @db.Uuid
  idempotencyKey    String             @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet            Outlet             @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  sale              Sale               @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  payment           BillingPayment     @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  registerSession   PosRegisterSession @relation(fields: [tenantId, registerSessionId], references: [tenantId, id], onDelete: Restrict)
  actor             User               @relation("RefundActor", fields: [actorId], references: [id], onDelete: Restrict)
  approver          User?              @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, idempotencyKey])
  @@index([tenantId, saleId])
  @@index([tenantId, registerSessionId, method])
  @@map("sales_refunds")
}

/// A cart set aside to finish later. Not an order: no number, no prices, no cash.
model PosHeldCart {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  outletId       String   @map("outlet_id") @db.Uuid
  label          String   @db.VarChar(60)
  lines          Json
  itemCount      Int      @map("item_count")
  createdBy      String   @map("created_by") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outlet         Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id], onDelete: Restrict)
  creator        User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, outletId, idempotencyKey])
  @@index([tenantId, outletId, createdAt])
  @@map("pos_held_carts")
}
