{
  "name": "@merchant/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "node --env-file=../../.env --import tsx src/index.ts --smoke",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.spec.ts",
    "format:check": "prettier --check . --ignore-path ../../.gitignore"
  },
  "devDependencies": {
    "@merchant/eslint-config": "workspace:*",
    "@merchant/typescript-config": "workspace:*"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1"
  }
}
