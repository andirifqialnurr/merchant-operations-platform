# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Production requires explicit true and an authenticated platform.docs.read session.
API_DOCS_ENABLED=true
AUTH_SESSION_TTL_HOURS=720
PLATFORM_SESSION_TTL_HOURS=12

# Data services (replace placeholders in a local .env file).
# `pnpm infra:up` starts Redis and object storage from
# infrastructure/docker/compose.dev.yml with the values below.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/merchant_operations?schema=public
REDIS_URL=redis://localhost:6379

# Only for `pnpm infra:up:all`, which also runs PostgreSQL in Docker. Keep
# DATABASE_URL in step with these. Leave unset when PostgreSQL is installed locally.
# POSTGRES_USER=<database-user>
# POSTGRES_PASSWORD=<database-password>
# POSTGRES_DB=merchant_operations
# POSTGRES_PORT=5432

# S3-compatible local object storage. The access key and secret become the
# storage server's root credentials; the bucket is created on start.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=<bucket-name>
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>
